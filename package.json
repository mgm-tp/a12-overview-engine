{
	"name": "root",
	"private": true,
	"author": "mgm technology partners",
	"version": "39.0.1",
	"a12Version": "2026.06-ext0",
	"type": "module",
	"scripts": {
		"clean": "rimraf */lib/** */dist/** */target/** *.tsbuildinfo */*.tsbuildinfo",
		"precompile": "pnpm -r initialize",
		"compile": "tsc -b tsconfig.build.json",
		"start": "pnpm -r --parallel start",
		"start:typescript": "tsc -b tsconfig.build.json --watch",
		"start:client": "pnpm --filter ./showcase start",
		"start:server": "pnpm --filter ./server start",
		"test": "pnpm -r test",
		"testE2E": "pnpm run --filter ./e2e testE2E",
		"dist": "pnpm -r dist",
		"lint": "pnpm \"/lint:/\"",
		"lint:detect-cycle": "devtools detect-cycles --ignore-type-imports \"./core/src/**/*.@(ts|tsx)\"",
		"lint:eslint": "eslint --quiet",
		"lint:prettier": "prettier . --check",
		"lint:headers": "node scripts/check-headers.js",
		"format": "pnpm \"/format:/\"",
		"format:eslint": "eslint --quiet --fix",
		"format:prettier": "prettier . --write"
	},
	"devDependencies": {
		"@com.mgmtp.a12.devtools/build-tools": "catalog:devLibs",
		"@com.mgmtp.a12.devtools/eslint-config": "catalog:devLibs",
		"@com.mgmtp.a12.devtools/prettier-config": "catalog:devLibs",
		"@com.mgmtp.a12.devtools/tsconfig": "catalog:devLibs",
		"@eslint/compat": "^2.1.0",
		"@jambit/eslint-plugin-typed-redux-saga": "^0.4.0",
		"@stylistic/eslint-plugin": "^5.10.0",
		"eslint": "^10.4.1",
		"eslint-plugin-filename-rules": "^1.3.1",
		"eslint-plugin-notice": "^1.0.0",
		"eslint-plugin-perfectionist": "^5.9.0",
		"eslint-plugin-unused-imports": "^4.3.0",
		"prettier": "^3.7.1",
		"redux-saga": "catalog:libs",
		"rimraf": "catalog:devLibs",
		"typed-redux-saga": "catalog:libs",
		"typescript": "catalog:libs"
	},
	"packageManager": "pnpm@10.18.2+sha512.9fb969fa749b3ade6035e0f109f0b8a60b5d08a1a87fdf72e337da90dcc93336e2280ca4e44f2358a649b83c17959e9993e777c2080879f3801e6f0d999ad3dd",
	"pnpm": {
		"patchedDependencies": {
			"react-dnd@16.0.1": "patches/react-dnd@16.0.1.patch"
		}
	}
}

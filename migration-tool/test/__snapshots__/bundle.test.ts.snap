// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`com.mgmtp.a12.overview-model-migration.bundle > contains a bin property which refers to an existing file that can be executed 1`] = `
"Usage: overview-model-migration <paths> [options]
<paths> can be specified as a
list of files or a folder that will be searched for overview model files

Options:
  -h, --help             Show help                    [boolean] [default: false]
      --version          Show version number                           [boolean]
  -b, --backup           Backup models before migration
                                                      [boolean] [default: false]
  -d, --debug            Print debug output           [boolean] [default: false]
  -n, --next             Migrate only to the next version, not further
                                                      [boolean] [default: false]
  -f, --force            Force migration even if the model has 'do-not-migrate'
                         annotation                   [boolean] [default: false]
      --validate-schema  Enable or disable validation of models against the JSON
                          schemas                      [boolean] [default: true]
"
`;

        "icon",
        "file_name",
        "icon_with_file_name"
      ]
    },
    "OverviewModel.MultiSelectDisplayMode": {
      "type": "string",
      "enum": [
        "comma_separated",
        "default"
      ]
    },
    "OverviewModel.Summary": {
      "type": "object",
      "properties": {
        "operation": {
          "$ref": "#/definitions/OverviewModel.Summary.Operation"
        }
      },
      "required": [
        "operation"
      ],
      "additionalProperties": false
    },
    "OverviewModel.Summary.Operation": {
      "type": "string",
      "const": "sum"
    },
    "OverviewModel.ExpressionColumn": {
      "type": "object",
      "properties": {
        "label": {
          "$ref": "#/definitions/LocalizedModelText"
        },
        "icon": {
          "$ref": "#/definitions/OverviewModel.Icon"
        },
        "labelHidden": {
          "type": "boolean",
          "const": true
        },
        "id": {
          "type": "string"
        },
        "width": {
          "$ref": "#/definitions/OverviewModel.Width"
        },
        "fixedWidth": {
          "type": "boolean",
          "const": true
        },
        "pinDirection": {
          "$ref": "#/definitions/OverviewModel.PinDirection"
        },
        "alignment": {
          "$ref": "#/definitions/OverviewModel.ColumnAlignment"
        },
        "styles": {
          "$ref": "#/definitions/OverviewModel.ColumnStyles"
        },
        "name": {
          "type": "string"
        },
        "expression": {
          "type": "string"
        }
      },
      "required": [
        "expression",
        "id",
        "name",
        "width"
      ],
      "additionalProperties": false
    },
    "OverviewModel.LinkColumn.Reference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "linkReferences": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/OverviewModel.LinkReference"
          }
        },
        "elementRef": {
          "type": "string"
        },
        "attachmentDisplayMode": {
          "$ref": "#/definitions/OverviewModel.AttachmentDisplayMode",
          "default": "{@link OverviewModel.AttachmentDisplayMode.PREVIEW }"
        },
        "multiSelectDisplayMode": {
          "$ref": "#/definitions/OverviewModel.MultiSelectDisplayMode"
        },
        "suffix": {
          "$ref": "#/definitions/LocalizedModelText"
        },
        "suffixRef": {
          "type": "string"
        },
        "label": {
          "$ref": "#/definitions/LocalizedModelText"
        },
        "icon": {
          "$ref": "#/definitions/OverviewModel.Icon"
        },
        "labelHidden": {
          "type": "boolean",
          "const": true
        },
        "id": {
          "type": "string"
        },
        "width": {
          "$ref": "#/definitions/OverviewModel.Width"
        },
        "fixedWidth": {
          "type": "boolean",
          "const": true
        },
        "pinDirection": {
          "$ref": "#/definitions/OverviewModel.PinDirection"
        },
        "alignment": {
          "$ref": "#/definitions/OverviewModel.ColumnAlignment"
        },
        "styles": {
          "$ref": "#/definitions/OverviewModel.ColumnStyles"
        }
      },
      "required": [
        "elementRef",
        "id",
        "linkReferences",
        "width"
      ]
    },
    "OverviewModel.LinkReference": {
      "type": "object",
      "properties": {
        "relationship": {
          "type": "string"
        },
        "targetRole": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "CHILD",
            "LINK"
          ]
        }
      },
      "required": [
        "relationship",
        "targetRole",
        "type"
      ],
      "additionalProperties": false
    },
    "OverviewModel.LinkColumn.Expression": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "linkReferences": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/OverviewModel.LinkReference"
          }
        },
        "label": {
          "$ref": "#/definitions/LocalizedModelText"

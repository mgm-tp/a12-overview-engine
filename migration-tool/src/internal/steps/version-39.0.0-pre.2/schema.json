        },
        "vertical": {
          "$ref": "#/definitions/OverviewModel.VerticalAlignment"
        }
      },
      "additionalProperties": false
    },
    "OverviewModel.HorizontalAlignment": {
      "type": "string",
      "enum": [
        "left",
        "center",
        "right"
      ]
    },
    "OverviewModel.VerticalAlignment": {
      "type": "string",
      "enum": [
        "top",
        "middle",
        "bottom"
      ]
    },
    "OverviewModel.ColumnStyles": {
      "type": "object",
      "properties": {
        "header": {
          "$ref": "#/definitions/OverviewModel.Styles"
        },
        "content": {
          "$ref": "#/definitions/OverviewModel.Styles"
        }
      },
      "additionalProperties": false
    },
